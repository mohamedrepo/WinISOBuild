# Build artefacts / large binaries (never commit) — folders are tracked, contents are not
Drivers/*
!Drivers/.gitkeep
Updates/*
!Updates/.gitkeep
Backup/*
!Backup/.gitkeep
ExtractedISO/*
!ExtractedISO/.gitkeep
ISO/*
!ISO/.gitkeep
Mount/*
!Mount/.gitkeep
Output/*
!Output/.gitkeep
Source/*
!Source/.gitkeep
WimMountUpdates/*
!WimMountUpdates/.gitkeep
*.iso
*.wim
*.esd
*.msu
*.cab
*.swm

# Runtime state, logs and generated reports (folders stay, contents do not)
Logs/*
!Logs/.gitkeep
State/*
!State/.gitkeep
Reports/*
!Reports/.gitkeep
Work/*
!Work/.gitkeep
.zwork/
